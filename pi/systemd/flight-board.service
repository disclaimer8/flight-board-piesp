[Unit]
Description=Flight board (HUB75 nearest-aircraft display)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# GPIO/DMA for the HUB75 panel needs root. rpi-rgb-led-matrix accesses /dev/mem,
# so this unit runs as root.
User=root
# Paths assume the repo was cloned to $HOME/flight-board-piesp and the Pi side
# lives in its pi/ subdirectory. Adjust the home segment (here: /home/pi) to the
# user that cloned it.
# Pin the CPU to max clock — a bit-banged display wants steady frequency, and
# 'ondemand' can downclock during brief idle dips and jitter the refresh.
ExecStartPre=-/bin/sh -c 'echo performance > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor'
WorkingDirectory=/home/pi/flight-board-piesp/pi
ExecStart=/home/pi/flight-board-piesp/pi/.venv/bin/python -m flight_board.main --config /home/pi/flight-board-piesp/pi/config.yaml
Restart=on-failure
RestartSec=5
# Single-core ARMv6: win the scheduler against background daemons. Safe vs the
# rgbmatrix refresh thread (it runs SCHED_FIFO/RT and always preempts nice).
Nice=-5
CPUWeight=200
# Let the process shut down cleanly on stop (SIGTERM is handled in main.py).
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
